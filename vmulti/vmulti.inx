;
; vmulti.inf -- VMulti reference HID driver for Win7 x86.
; Adapted from github.com/djpnewton/vmulti, simplified for our build:
;   * Drop XP/Vista section (we only target Win7)
;   * Drop hidkmdf filter (Win7 has inbox mshidkmdf)
;   * Hardcode KMDF 1.9 instead of $KMDFVERSION$ macro
;
[Version]
Signature   = "$WINDOWS NT$"
Class       = HIDClass
ClassGuid   = {745A17A0-74D3-11D0-B6FE-00A0C90F57DA}
Provider    = %VENDOR%
CatalogFile = vmulti.cat
DriverVer   = 05/06/2026,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12
vmulti.Inst_CoInstaller_CopyFiles = 11

[SourceDisksNames]
1 = %DISK_NAME%,,,""

[SourceDisksFiles]
vmulti.sys              = 1
WdfCoInstaller01009.dll = 1

[Manufacturer]
%VENDOR% = Vendor, NT$ARCH$

[Vendor.NT$ARCH$]
%vmulti% = vmulti.Inst, djpnewton\vmulti

[vmulti.Inst.NT]
CopyFiles = CopyFunctionDriver

[CopyFunctionDriver]
vmulti.sys

[vmulti.Inst.NT.HW]
AddReg = vmulti_Win7_Parameters.AddReg

[vmulti_Win7_Parameters.AddReg]
HKR,,"UpperFilters",0x00010000,"mshidkmdf"

[vmulti.Inst.NT.Services]
AddService = vmulti, 0x00000002, vmulti_Service_Inst

[vmulti_Service_Inst]
DisplayName    = %vmulti%
ServiceType    = 1   ; SERVICE_KERNEL_DRIVER
StartType      = 3   ; SERVICE_DEMAND_START
ErrorControl   = 1   ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\vmulti.sys

[vmulti.Inst.NT.CoInstallers]
AddReg    = vmulti.Inst_CoInstaller_AddReg
CopyFiles = vmulti.Inst_CoInstaller_CopyFiles

[vmulti.Inst_CoInstaller_AddReg]
HKR,,CoInstallers32,0x00010000,"WdfCoInstaller01009.dll,WdfCoInstaller"

[vmulti.Inst_CoInstaller_CopyFiles]
WdfCoInstaller01009.dll

[vmulti.Inst.NT.Wdf]
KmdfService = vmulti, vmulti_wdfsect

[vmulti_wdfsect]
KmdfLibraryVersion = 1.9

[Strings]
VENDOR    = "djpnewton@gmail.com"
vmulti    = "VMulti HID"
DISK_NAME = "VMulti Device Install Disk"
