# --- Build artifacts ---
build/
payload/
*.obj
*.pdb
*.ilk
*.exp
*.lib
app/*.exe
app/*.obj

# --- Driver build outputs ---
driver/build/
app/build/

# --- Sensitive: private keys ---
tools/cert/*.pvk
tools/cert/*.pfx
# Public certs are kept (so others can verify the signed driver)
!tools/cert/*.cer

# --- BSOD dumps & debug symbols ---
*.dmp
*.bin
.state/dumps/
.state/symbols/
.state/diag_*.txt
.state/hidcaps.txt

# --- Sensitive: VM access credentials & status notes ---
.state/VM_ACCESS.md
.state/STATUS.md

# --- AI agent / Claude internal ---
CLAUDE.md
.claude/
_initial_brief.md

