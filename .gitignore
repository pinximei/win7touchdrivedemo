vmulti/build/
vmulti/*.obj
vmulti/*.pdb

# --- third_party clone of upstream vmulti (don't embed as nested git repo) ---
third_party/

# --- IDE / OS junk ---
.vs/
*.suo
*.user
Thumbs.db
.DS_Store
