_runfirst.cmd
desktop_probe.bat
find_browser.bat
full_diag.bat
probe_delayed.bat
probe_now.bat
test_gesture.bat
runtouch.bat

# --- Diagnostic helper scripts under tools/ (kept build/sign/deploy/setup_vm/reinstall only) ---
tools/check_col1.ps1
tools/cleanup_oem.ps1
tools/deploy.bat.lf
tools/diag2.bat
tools/diag_chain.ps1
